{
  "name": "chain-of-record-backend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "coverage:js": "c8 --reporter=text-summary --include 'server/**' --include 'blockchain/**' hardhat test",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "start": "node server/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://chain:chain@localhost:5544/chain_of_record} hardhat test",
    "create-user": "node scripts/create-user.js",
    "db:check": "node scripts/db-check.js",
    "import:karnataka": "node scripts/import-karnataka.js",
    "db:reset": "node scripts/reset-db.js",
    "chain:evaluate": "hardhat run scripts/evaluate-verification.js",
    "chain:photos": "hardhat run scripts/make-sample-photos.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@openzeppelin/contracts": "^5.1.0",
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "hardhat": "^2.22.17",
    "jsqr": "^1.4.0",
    "sharp": "^0.33.5",
    "solidity-coverage": "^0.8.16",
    "supertest": "^7.0.0",
    "tesseract.js": "^5.1.1"
  }
}
