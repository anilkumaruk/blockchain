# Copy to .env and adjust. Never commit .env.

# ---- API server ---------------------------------------------------------
# NODE_ENV=production turns on strict startup checks (see server/config.js)
NODE_ENV=development
PORT=4000
# At least 32 random characters in production: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=1h
# Comma-separated allowed frontend origins (required in production)
CORS_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy (Render, Railway, nginx) so
# rate limits and the audit log see the real client IP
# TRUST_PROXY=1
INSTITUTION_NAME=Alliance University

# First account, created only when the users table is empty. It is the PLATFORM
# admin: it approves or suspends universities, pauses the registry and reads the
# audit log, but cannot issue. University registrar logins come from
# `npm run import:karnataka` or from /register/institution + approval.
ADMIN_USERNAME=platform.admin
ADMIN_PASSWORD=

# ---- Database (PostgreSQL, required) -------------------------------------
# Local: npm run db:up
DATABASE_URL=postgres://chain:chain@localhost:5544/chain_of_record
#
# Supabase: Project -> Connect -> "Session pooler" URI (IPv4-friendly), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# and the CA from Project Settings -> Database -> SSL Configuration -> Download certificate:
# DATABASE_SSL_CA=certs/prod-ca-2021.crt
#
# Other hosted Postgres (Neon, RDS...) with publicly trusted certificates:
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10
# Throwaway demo without a database (refused in production):
# USE_MEMORY_STORE=true
# A query that gets no answer fails after this many milliseconds (default 20000)
# DATABASE_QUERY_TIMEOUT_MS=20000

# ---- Blockchain --------------------------------------------------------
# The project's own chain is stored in this database: no blockchain node runs.
# localhost: nothing leaves this machine.
# sepolia:   each new block's hash is also anchored in deployments/sepolia.json's
#            contract on Ethereum Sepolia (needs SEPOLIA_RPC_URL or RPC_URL).
CHAIN_NETWORK=localhost
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Authority key: signs block 0 and the platform university's transactions, and
# pays for Sepolia anchors. Unset on localhost (a public development key is
# used); required, and must be a real private key, on sepolia.
# ISSUER_PRIVATE_KEY=
# Optional: treat this address as the platform university (default: authority)
# TRUSTED_ISSUER_ADDRESS=

# ---- Sepolia deployment (npm run deploy:sepolia) -----------------------
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<project-id>
# DEPLOYER_PRIVATE_KEY=

# ---- Institutions and validators --------------------------------------------
# Encrypts each approved institution's signing key (64 hex chars), and the
# 3 validator node keys are derived from it. Required in production:
# openssl rand -hex 32. Never change it once set: existing institution keys
# could no longer be decrypted and the validators named in block 0 could no
# longer sign new blocks.
# WALLET_ENCRYPTION_KEY=
# Not used by the own chain (no gas); kept for the earlier Solidity-only mode.
# INSTITUTION_FUNDING_ETH=
