# Copy to .env and adjust. Never commit .env.

# ---- API server ---------------------------------------------------------
# NODE_ENV=production turns on strict startup checks (see server/config.js)
NODE_ENV=development
PORT=4000
# At least 32 random characters in production: openssl rand -hex 32
JWT_SECRET=
JWT_TTL=1h
# Comma-separated allowed frontend origins (required in production)
CORS_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy (Render, Railway, nginx) so
# rate limits and the audit log see the real client IP
# TRUST_PROXY=1
INSTITUTION_NAME=Alliance University

# First admin account, created only when the users table is empty.
# Add more accounts with: npm run create-user -- <username> <admin|student> [studentId]
ADMIN_USERNAME=registrar.admin
ADMIN_PASSWORD=

# ---- Database (PostgreSQL, required) -------------------------------------
# Local: npm run db:up
DATABASE_URL=postgres://chain:chain@localhost:5544/chain_of_record
#
# Supabase: Project -> Connect -> "Session pooler" URI (IPv4-friendly), e.g.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# and the CA from Project Settings -> Database -> SSL Configuration -> Download certificate:
# DATABASE_SSL_CA=certs/prod-ca-2021.crt
#
# Other hosted Postgres (Neon, RDS...) with publicly trusted certificates:
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10
# Throwaway demo without a database (refused in production):
# USE_MEMORY_STORE=true

# ---- Blockchain --------------------------------------------------------
# Which deployments/<network>.json to load (localhost | sepolia)
CHAIN_NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
# Issuer wallet that signs issue/revoke transactions. Unset on localhost
# (Hardhat dev account #0 is used); required — and must be a real, private
# key — on any public network.
# ISSUER_PRIVATE_KEY=
# Optional: trust a specific issuer address (defaults to the contract owner)
# TRUSTED_ISSUER_ADDRESS=

# ---- Sepolia deployment (npm run deploy:sepolia) -----------------------
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<project-id>
# DEPLOYER_PRIVATE_KEY=

# ---- Institutions --------------------------------------------------------
# Encrypts each approved institution's issuer wallet key (64 hex chars).
# Required in production: openssl rand -hex 32. Never change it once set,
# or existing institution wallets can no longer be decrypted.
# WALLET_ENCRYPTION_KEY=
# ETH sent to a newly approved institution for gas (default 1 on localhost, 0.02 elsewhere)
# INSTITUTION_FUNDING_ETH=
