{
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{backend/server/migrations/**,backend/deployments/sepolia.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
